APP_NAME=examate-rag
ENVIRONMENT=local
# Set a Gemini API key to enable POST /chat. Never commit the real .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRIES=1
# Optional rates used to estimate cost; enter USD per 1 million tokens.
GEMINI_INPUT_COST_PER_MILLION=
GEMINI_OUTPUT_COST_PER_MILLION=
GEMINI_FALLBACK_INPUT_COST_PER_MILLION=
GEMINI_FALLBACK_OUTPUT_COST_PER_MILLION=
# Docker Compose overrides this with the internal Postgres hostname.
DATABASE_URL=postgresql://app:app@localhost:5432/rag
